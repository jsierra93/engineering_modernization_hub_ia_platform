{
  "Comment": "Modernization run state machine, rendered through templatefile() (see ../main.tf).",
  "StartAt": "FetchRepo",
  "States": {
    "FetchRepo": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${lambda_task_timeout_seconds},
      "Parameters": {
        "FunctionName": "${fetch_repo_lambda_arn}",
        "Payload": {
          "run_id.$": "$.run_id",
          "repo.$": "$.repo",
          "commit.$": "$.commit"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultSelector": {
        "bucket.$": "$.Payload.bucket",
        "workspace_get_url.$": "$.Payload.workspace_get_url",
        "junit_put_url.$": "$.Payload.junit_put_url",
        "junit_key.$": "$.Payload.junit_key"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.verdict_error",
          "Next": "RecordStuckRun"
        }
      ],
      "ResultPath": "$.fetch_repo_result",
      "Next": "Baseline"
    },

    "Baseline": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "${sandbox_cluster_arn}",
        "TaskDefinition.$": "$.sandbox_task_definition_arn",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${sandbox_subnet_ids},
            "SecurityGroups": ${sandbox_security_group_ids},
            "AssignPublicIp": "${sandbox_assign_public_ip}"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "${sandbox_container_name}",
              "Command": ["unit_tests"],
              "Environment": [
                { "Name": "WORKSPACE_GET_URL", "Value.$": "$.fetch_repo_result.workspace_get_url" },
                { "Name": "JUNIT_PUT_URL", "Value.$": "$.fetch_repo_result.junit_put_url" }
              ]
            }
          ]
        }
      },
      "Retry": [
        {
          "Comment": "Capacity and throttling only; a non-zero container exit is a real check result.",
          "ErrorEquals": ["ECS.AmazonECSException", "ECS.ServerException", "ECS.ThrottlingException", "States.TaskFailed.Capacity"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "TimeoutSeconds": ${sandbox_task_timeout_seconds},
      "ResultPath": "$.baseline_result",
      "Catch": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "ResultPath": "$.baseline_error",
          "Next": "RecordBaselineBlocked"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.verdict_error",
          "Next": "RecordUnrecoverableVerdict"
        }
      ],
      "Next": "BaselineLint"
    },

    "RecordBaselineBlocked": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${lambda_task_timeout_seconds},
      "Parameters": {
        "FunctionName": "${core_ops_lambda_arn}",
        "Payload": {
          "action": "compute_verdict",
          "run_id.$": "$.run_id",
          "workspaces_bucket.$": "$.fetch_repo_result.bucket",
          "baseline_junit_key.$": "$.fetch_repo_result.junit_key",
          "final_junit_key.$": "$.fetch_repo_result.junit_key",
          "baseline_failed": true,
          "checks": {}
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.verdict_error",
          "Next": "RecordStuckRun"
        }
      ],
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultPath": "$.verdict_result",
      "End": true
    },

"BaselineLint": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "${sandbox_cluster_arn}",
        "TaskDefinition.$": "$.sandbox_task_definition_arn",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${sandbox_subnet_ids},
            "SecurityGroups": ${sandbox_security_group_ids},
            "AssignPublicIp": "${sandbox_assign_public_ip}"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "${sandbox_container_name}",
              "Command": ["lint"],
              "Environment": [
                { "Name": "WORKSPACE_GET_URL", "Value.$": "$.fetch_repo_result.workspace_get_url" },
                { "Name": "JUNIT_PUT_URL", "Value.$": "$.fetch_repo_result.junit_put_url" }
              ]
            }
          ]
        }
      },
      "Retry": [
        {
          "Comment": "Capacity and throttling only; a non-zero container exit is a real check result.",
          "ErrorEquals": ["ECS.AmazonECSException", "ECS.ServerException", "ECS.ThrottlingException", "States.TaskFailed.Capacity"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "TimeoutSeconds": ${sandbox_task_timeout_seconds},
      "ResultPath": "$.baseline_lint_result",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.baseline_lint_error",
          "Next": "MarkBaselineLintDirty"
        }
      ],
      "Next": "MarkBaselineLintClean"
    },

    "MarkBaselineLintClean": {
      "Type": "Pass",
      "Result": { "lint": true },
      "ResultPath": "$.baseline_clean",
      "Next": "DiscoveryPlan"
    },

    "MarkBaselineLintDirty": {
      "Type": "Pass",
      "Result": { "lint": false },
      "ResultPath": "$.baseline_clean",
      "Next": "DiscoveryPlan"
    },

    "DiscoveryPlan": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${agent_task_timeout_seconds},
      "Parameters": {
        "FunctionName": "${agent_phase_lambda_arn}",
        "Payload": {
          "run_id.$": "$.run_id",
          "phase": "discovery_plan",
          "strategy_id.$": "$.strategy_id",
          "excluded_paths.$": "$.excluded_paths",
          "objetivo.$": "$.objetivo"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultSelector": {
        "plan.$": "$.Payload.result",
        "cost_usd.$": "$.Payload.cost_usd",
        "denials.$": "$.Payload.denials",
        "model_id.$": "$.Payload.model_id"
      },
      "ResultPath": "$.discovery_plan_result",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.agent_error",
          "Next": "RecordUnrecoverableVerdict"
        }
      ],
      "Next": "RecordDiscoveryPlanSpend"
    },

    "RecordDiscoveryPlanSpend": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${lambda_task_timeout_seconds},
      "Parameters": {
        "FunctionName": "${core_ops_lambda_arn}",
        "Payload": {
          "action": "record_spend",
          "run_id.$": "$.run_id",
          "delta_usd.$": "$.discovery_plan_result.cost_usd",
          "denials.$": "$.discovery_plan_result.denials",
          "model_id.$": "$.discovery_plan_result.model_id",
          "phase": "discovery_plan"
        }
      },
      "Retry": [
        {
          "Comment": "Retry only pre-invocation errors: add_spend is not idempotent, so a repeat would double-charge.",
          "ErrorEquals": ["Lambda.TooManyRequestsException", "Lambda.SdkClientException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultSelector": {
        "spent_usd.$": "$.Payload.spent_usd",
        "budget_exhausted.$": "$.Payload.budget_exhausted"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.verdict_error",
          "Next": "RecordStuckRun"
        }
      ],
      "ResultPath": "$.spend_result",
      "Next": "CheckBudgetDiscoveryPlan"
    },

    "CheckBudgetDiscoveryPlan": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.spend_result.budget_exhausted",
          "BooleanEquals": true,
          "Next": "ComputeBudgetExhaustedVerdict"
        }
      ],
      "Default": "CheckViability"
    },

    "CheckViability": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.discovery_plan_result.plan.viable",
          "BooleanEquals": false,
          "Next": "RecordInfeasibleVerdict"
        }
      ],
      "Default": "RecordPlan"
    },

    "RecordInfeasibleVerdict": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${lambda_task_timeout_seconds},
      "Parameters": {
        "FunctionName": "${core_ops_lambda_arn}",
        "Payload": {
          "action": "compute_verdict",
          "run_id.$": "$.run_id",
          "workspaces_bucket.$": "$.fetch_repo_result.bucket",
          "baseline_junit_key.$": "$.fetch_repo_result.junit_key",
          "final_junit_key.$": "$.fetch_repo_result.junit_key",
          "agent_concluded_infeasible": true,
          "plan.$": "$.discovery_plan_result.plan",
          "checks": {}
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.verdict_error",
          "Next": "RecordStuckRun"
        }
      ],
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultPath": "$.verdict_result",
      "End": true
    },

    "RecordPlan": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${lambda_task_timeout_seconds},
      "Parameters": {
        "FunctionName": "${core_ops_lambda_arn}",
        "Payload": {
          "action": "record_plan",
          "run_id.$": "$.run_id",
          "plan.$": "$.discovery_plan_result.plan"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultSelector": {
        "plan_hash.$": "$.Payload.plan_hash",
        "status.$": "$.Payload.status"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.verdict_error",
          "Next": "RecordStuckRun"
        }
      ],
      "ResultPath": "$.record_plan_result",
      "Next": "NotifyApprovalPending"
    },

    "NotifyApprovalPending": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "TimeoutSeconds": ${lambda_task_timeout_seconds},
      "Parameters": {
        "QueueUrl": "${notifications_queue_url}",
        "MessageBody": {
          "event_type": "AWAITING_APPROVAL",
          "run_id.$": "$.run_id",
          "plan_hash.$": "$.record_plan_result.plan_hash"
        }
      },
      "ResultPath": "$.notify_result",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.notify_error",
          "Next": "AwaitApproval"
        }
      ],
      "Next": "AwaitApproval"
    },

    "AwaitApproval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${core_ops_lambda_arn}",
        "Payload": {
          "action": "record_task_token",
          "run_id.$": "$.run_id",
          "task_token.$": "$$.Task.Token"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "TimeoutSeconds": ${approval_timeout_seconds},
      "Catch": [
        {
          "ErrorEquals": ["States.Timeout"],
          "ResultPath": "$.approval_timeout",
          "Next": "RecordApprovalTimeout"
        }
      ],
      "ResultPath": "$.approval_result",
      "Next": "Implement"
    },

    "Implement": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${agent_task_timeout_seconds},
      "Parameters": {
        "FunctionName": "${agent_phase_lambda_arn}",
        "Payload": {
          "run_id.$": "$.run_id",
          "phase": "implement",
          "strategy_id.$": "$.strategy_id",
          "excluded_paths.$": "$.excluded_paths",
          "plan.$": "$.discovery_plan_result.plan"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultSelector": {
        "workspace_get_url.$": "$.Payload.workspace_get_url",
        "junit_put_url.$": "$.Payload.junit_put_url",
        "junit_key.$": "$.Payload.junit_key",
        "bucket.$": "$.Payload.bucket",
        "cost_usd.$": "$.Payload.cost_usd",
        "denials.$": "$.Payload.denials",
        "model_id.$": "$.Payload.model_id"
      },
      "ResultPath": "$.implement_result",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.agent_error",
          "Next": "RecordUnrecoverableVerdict"
        }
      ],
      "Next": "RecordImplementSpend"
    },

    "RecordImplementSpend": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${lambda_task_timeout_seconds},
      "Parameters": {
        "FunctionName": "${core_ops_lambda_arn}",
        "Payload": {
          "action": "record_spend",
          "run_id.$": "$.run_id",
          "delta_usd.$": "$.implement_result.cost_usd",
          "denials.$": "$.implement_result.denials",
          "model_id.$": "$.implement_result.model_id",
          "phase": "implement"
        }
      },
      "Retry": [
        {
          "Comment": "Retry only pre-invocation errors: add_spend is not idempotent, so a repeat would double-charge.",
          "ErrorEquals": ["Lambda.TooManyRequestsException", "Lambda.SdkClientException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultSelector": {
        "spent_usd.$": "$.Payload.spent_usd",
        "budget_exhausted.$": "$.Payload.budget_exhausted"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.verdict_error",
          "Next": "RecordStuckRun"
        }
      ],
      "ResultPath": "$.spend_result",
      "Next": "CheckBudgetImplement"
    },

    "CheckBudgetImplement": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.spend_result.budget_exhausted",
          "BooleanEquals": true,
          "Next": "ComputeBudgetExhaustedVerdict"
        }
      ],
      "Default": "Verify"
    },

    "Verify": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "${sandbox_cluster_arn}",
        "TaskDefinition.$": "$.sandbox_task_definition_arn",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${sandbox_subnet_ids},
            "SecurityGroups": ${sandbox_security_group_ids},
            "AssignPublicIp": "${sandbox_assign_public_ip}"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "${sandbox_container_name}",
              "Command": ["unit_tests"],
              "Environment": [
                { "Name": "WORKSPACE_GET_URL", "Value.$": "$.implement_result.workspace_get_url" },
                { "Name": "JUNIT_PUT_URL", "Value.$": "$.implement_result.junit_put_url" }
              ]
            }
          ]
        }
      },
      "Retry": [
        {
          "Comment": "Capacity and throttling only; a non-zero container exit is a real check result.",
          "ErrorEquals": ["ECS.AmazonECSException", "ECS.ServerException", "ECS.ThrottlingException", "States.TaskFailed.Capacity"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "TimeoutSeconds": ${sandbox_task_timeout_seconds},
      "ResultSelector": { "exit_code.$": "$.Containers[0].ExitCode" },
      "ResultPath": "$.verify_result",
      "Catch": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "ResultPath": "$.verify_error",
          "Next": "CheckIterations"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.verdict_error",
          "Next": "RecordUnrecoverableVerdict"
        }
      ],
      "Next": "Lint"
    },

    "CheckIterations": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.iteration",
          "NumericLessThanPath": "$.max_iterations",
          "Next": "Fix"
        }
      ],
      "Default": "ComputeExhaustedVerdict"
    },

    "Fix": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${agent_task_timeout_seconds},
      "Parameters": {
        "FunctionName": "${agent_phase_lambda_arn}",
        "Payload": {
          "run_id.$": "$.run_id",
          "phase": "fix",
          "strategy_id.$": "$.strategy_id",
          "excluded_paths.$": "$.excluded_paths",
          "junit_key.$": "$.implement_result.junit_key",
          "iteration.$": "$.iteration",
          "max_iterations.$": "$.max_iterations"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultSelector": {
        "workspace_get_url.$": "$.Payload.workspace_get_url",
        "junit_put_url.$": "$.Payload.junit_put_url",
        "junit_key.$": "$.Payload.junit_key",
        "bucket.$": "$.Payload.bucket",
        "cost_usd.$": "$.Payload.cost_usd",
        "denials.$": "$.Payload.denials",
        "model_id.$": "$.Payload.model_id"
      },
      "ResultPath": "$.implement_result",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.agent_error",
          "Next": "RecordUnrecoverableVerdict"
        }
      ],
      "Next": "RecordFixSpend"
    },

    "RecordFixSpend": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${lambda_task_timeout_seconds},
      "Parameters": {
        "FunctionName": "${core_ops_lambda_arn}",
        "Payload": {
          "action": "record_spend",
          "run_id.$": "$.run_id",
          "delta_usd.$": "$.implement_result.cost_usd",
          "denials.$": "$.implement_result.denials",
          "model_id.$": "$.implement_result.model_id",
          "phase": "implement"
        }
      },
      "Retry": [
        {
          "Comment": "Retry only pre-invocation errors: add_spend is not idempotent, so a repeat would double-charge.",
          "ErrorEquals": ["Lambda.TooManyRequestsException", "Lambda.SdkClientException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultSelector": {
        "spent_usd.$": "$.Payload.spent_usd",
        "budget_exhausted.$": "$.Payload.budget_exhausted"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.verdict_error",
          "Next": "RecordStuckRun"
        }
      ],
      "ResultPath": "$.spend_result",
      "Next": "CheckBudgetFix"
    },

    "CheckBudgetFix": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.spend_result.budget_exhausted",
          "BooleanEquals": true,
          "Next": "ComputeBudgetExhaustedVerdict"
        }
      ],
      "Default": "IncrementIteration"
    },

    "IncrementIteration": {
      "Type": "Pass",
      "Parameters": {
        "iteration.$": "States.MathAdd($.iteration, 1)"
      },
      "ResultPath": "$.bump",
      "Next": "ApplyIteration"
    },

    "ApplyIteration": {
      "Type": "Pass",
      "InputPath": "$.bump.iteration",
      "ResultPath": "$.iteration",
      "Next": "Verify"
    },

    "RecordUnrecoverableVerdict": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${lambda_task_timeout_seconds},
      "Parameters": {
        "FunctionName": "${core_ops_lambda_arn}",
        "Payload": {
          "action": "compute_verdict",
          "run_id.$": "$.run_id",
          "workspaces_bucket.$": "$.fetch_repo_result.bucket",
          "baseline_junit_key.$": "$.fetch_repo_result.junit_key",
          "final_junit_key.$": "$.fetch_repo_result.junit_key",
          "unrecoverable_error": true,
          "checks": {}
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.verdict_error",
          "Next": "RecordStuckRun"
        }
      ],
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultPath": "$.verdict_result",
      "End": true
    },


    "RecordApprovalTimeout": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${lambda_task_timeout_seconds},
      "Parameters": {
        "FunctionName": "${core_ops_lambda_arn}",
        "Payload": {
          "action": "compute_verdict",
          "run_id.$": "$.run_id",
          "workspaces_bucket.$": "$.fetch_repo_result.bucket",
          "baseline_junit_key.$": "$.fetch_repo_result.junit_key",
          "final_junit_key.$": "$.fetch_repo_result.junit_key",
          "approval_timed_out": true,
          "checks": {}
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.verdict_error",
          "Next": "RecordStuckRun"
        }
      ],
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultPath": "$.verdict_result",
      "End": true
    },
    "ComputeBudgetExhaustedVerdict": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${lambda_task_timeout_seconds},
      "Parameters": {
        "FunctionName": "${core_ops_lambda_arn}",
        "Payload": {
          "action": "compute_verdict",
          "run_id.$": "$.run_id",
          "workspaces_bucket.$": "$.fetch_repo_result.bucket",
          "baseline_junit_key.$": "$.fetch_repo_result.junit_key",
          "final_junit_key.$": "$.fetch_repo_result.junit_key",
          "checks": {}
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.verdict_error",
          "Next": "RecordStuckRun"
        }
      ],
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultPath": "$.verdict_result",
      "End": true
    },

    "RecordStuckRun": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${lambda_task_timeout_seconds},
      "Parameters": {
        "FunctionName": "${core_ops_lambda_arn}",
        "Payload": {
          "action": "record_terminal_failure",
          "run_id.$": "$.run_id",
          "cause.$": "$.verdict_error.Cause"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.stuck_error",
          "Next": "ExecutionFailed"
        }
      ],
      "ResultPath": "$.stuck_result",
      "End": true
    },

    "ExecutionFailed": {
      "Type": "Fail",
      "Error": "RunStateNotRecorded",
      "Cause": "The terminal state of the run could not be written."
    },

    "ComputeExhaustedVerdict": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${lambda_task_timeout_seconds},
      "Parameters": {
        "FunctionName": "${core_ops_lambda_arn}",
        "Payload": {
          "action": "compute_verdict",
          "iteration.$": "$.iteration",
          "run_id.$": "$.run_id",
          "workspaces_bucket.$": "$.fetch_repo_result.bucket",
          "baseline_junit_key.$": "$.fetch_repo_result.junit_key",
          "final_junit_key.$": "$.implement_result.junit_key",
          "fix_iterations_exhausted_without_pass": true,
          "check_evidence": {
            "unit_tests": { "error.$": "$.verify_error" }
          }
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.verdict_error",
          "Next": "RecordStuckRun"
        }
      ],
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultPath": "$.verdict_result",
      "End": true
    },

    "Lint": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "${sandbox_cluster_arn}",
        "TaskDefinition.$": "$.sandbox_task_definition_arn",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${sandbox_subnet_ids},
            "SecurityGroups": ${sandbox_security_group_ids},
            "AssignPublicIp": "${sandbox_assign_public_ip}"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "${sandbox_container_name}",
              "Command": ["lint"],
              "Environment": [
                { "Name": "WORKSPACE_GET_URL", "Value.$": "$.implement_result.workspace_get_url" },
                { "Name": "JUNIT_PUT_URL", "Value.$": "$.implement_result.junit_put_url" }
              ]
            }
          ]
        }
      },
      "Retry": [
        {
          "Comment": "Capacity and throttling only; a non-zero container exit is a real check result.",
          "ErrorEquals": ["ECS.AmazonECSException", "ECS.ServerException", "ECS.ThrottlingException", "States.TaskFailed.Capacity"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "TimeoutSeconds": ${sandbox_task_timeout_seconds},
      "ResultSelector": { "exit_code.$": "$.Containers[0].ExitCode" },
      "ResultPath": "$.lint_result",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.lint_error",
          "Next": "ComputeVerdictLintFailed"
        }
      ],
      "Next": "ComputeFinalVerdict"
    },

    "ComputeFinalVerdict": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${lambda_task_timeout_seconds},
      "Parameters": {
        "FunctionName": "${core_ops_lambda_arn}",
        "Payload": {
          "action": "compute_verdict",
          "iteration.$": "$.iteration",
          "run_id.$": "$.run_id",
          "workspaces_bucket.$": "$.fetch_repo_result.bucket",
          "baseline_junit_key.$": "$.fetch_repo_result.junit_key",
          "final_junit_key.$": "$.implement_result.junit_key",
          "baseline_clean.$": "$.baseline_clean",
          "check_evidence": {
            "unit_tests": { "exit_code.$": "$.verify_result.exit_code" },
            "lint": { "exit_code.$": "$.lint_result.exit_code" }
          }
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.verdict_error",
          "Next": "RecordStuckRun"
        }
      ],
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultPath": "$.verdict_result",
      "End": true
    },

    "ComputeVerdictLintFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${lambda_task_timeout_seconds},
      "Parameters": {
        "FunctionName": "${core_ops_lambda_arn}",
        "Payload": {
          "action": "compute_verdict",
          "iteration.$": "$.iteration",
          "run_id.$": "$.run_id",
          "workspaces_bucket.$": "$.fetch_repo_result.bucket",
          "baseline_junit_key.$": "$.fetch_repo_result.junit_key",
          "final_junit_key.$": "$.implement_result.junit_key",
          "baseline_clean.$": "$.baseline_clean",
          "check_evidence": {
            "unit_tests": { "exit_code.$": "$.verify_result.exit_code" },
            "lint": { "error.$": "$.lint_error" }
          }
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.verdict_error",
          "Next": "RecordStuckRun"
        }
      ],
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultPath": "$.verdict_result",
      "End": true
    }
  }
}
