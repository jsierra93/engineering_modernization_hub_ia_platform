# Windows fix, 2026-09-26: this repo's checkout path is long enough
# (Documents/repositories/engineering_modernization_hub_ia_platform/apps/
# backstage/...) that pnpm's default virtual store
# (node_modules/.pnpm/<pkg>@<version>_<hash-of-peer-deps>/...) pushes
# resolved paths for deeply-nested packages (e.g. @backstage/ui, whose
# .pnpm folder name alone is ~125 chars) past Windows' 260-char MAX_PATH.
# Node/webpack then silently fall back to the \\?\ extended-length path
# prefix, which style-loader's runtime module resolution does not handle
# correctly on this toolchain -- it drops the drive letter, turning
# "C:\Users\..." into ".\Users\..." (a real, reproduced "Module not
# found" error, not a hypothetical). Moving the virtual store to a short,
# fixed path outside the repo keeps every resolved path well under the
# limit regardless of how long this checkout's own path is.
virtual-store-dir=C:/pnpm-vs/backstage

# Fixes a second, unrelated pre-existing issue: `pnpm tsc` (the root
# typecheck-and-emit-declarations pass, needed before a production
# backend build) failed with TS2742 ("inferred type ... cannot be named
# without a reference to '.pnpm/@types+react@.../...'") on App.tsx and
# the Logo components. Root cause: pnpm's strict per-consumer resolution
# can materialize more than one physical @types/react folder across the
# workspace even under the same semver range, and tsc can't portably
# name a type that structurally depends on "which instance". Hoisting
# every @types/react(-dom) resolution to a single shared copy removes
# the ambiguity.
public-hoist-pattern[]=*@types/react*
public-hoist-pattern[]=*@types/react-dom*
# Same root cause, different symptom: the root tsconfig's "types": ["node",
# "webpack-env"] entry needs @types/node and @types/webpack-env resolvable
# from a node_modules/@types visible to the root tsconfig -- pnpm's strict
# layout doesn't hoist them there by default even though something in the
# workspace depends on them transitively.
public-hoist-pattern[]=*@types/node*
public-hoist-pattern[]=*@types/webpack-env*
